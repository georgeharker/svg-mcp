{
  "name": "svg-mcp",
  "version": "0.6.0",
  "description": "Structured, hierarchical SVG authoring for an LLM with a render-and-see feedback loop \u2014 CSS-native themes (design language + variants), declarative box-arrow diagrams with auto-layout, data-parametric charts, and annotation facades, backed by an inkex document model.",
  "author": {
    "name": "George Harker",
    "email": "george@georgeharker.com"
  },
  "homepage": "https://github.com/georgeharker/svg-mcp",
  "repository": "https://github.com/georgeharker/svg-mcp",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "svg",
    "mcp",
    "fastmcp",
    "inkex",
    "vector",
    "graphics",
    "diagrams",
    "charts",
    "themes"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 300,
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
